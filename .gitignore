# .gitignore for Terraform
# Ignore Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Ignore .terraform directory
.terraform/
.terraform.lock.hcl

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore variable files with sensitive data
terraform.tfvars
*.auto.tfvars

# Ignore crash log files
crash.log
crash.*.log

# Node modules
node_modules/

# Logs
logs/
*.log
npm-debug.log*

# Environment variables
.env
.env.local

# OS files
.DS_Store
Thumbs.db
